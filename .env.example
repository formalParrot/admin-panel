PORT=9879
SESSION_SECRET=
ADMIN_PIN= # bcrypt hash of your PIN
ADMIN_KEY= # optional: x-admin-key header auth

TRUST_PROXY=1

LOCK_API_URL=https://api.justparrot.me
LOCK_INTERNAL_URL= # internal URL to reach lock service (e.g. http://127.0.0.1:PORT). Falls back to LOCK_API_URL
LOCK_ADMIN_SECRET=

F42_INTERNAL_URL= # internal URL to reach F42 API (e.g. http://127.0.0.1:PORT). Falls back to https://api.justparrot.me
F42_WS_INTERNAL_URL= # internal WebSocket URL for F42 (e.g. ws://127.0.0.1:PORT). Falls back to wss://api.justparrot.me
F42_API_KEY=

WEBHOOK_TOKEN=

LOGIN_RATE_LIMIT=30
API_RATE_LIMIT=100
WEBHOOK_RATE_LIMIT=100
